# Upstash Redis — required for real visitor counter and hall of fame.
# Create a free database at https://console.upstash.com/ and paste the REST
# credentials below. Without these, the app falls back to an in-memory store
# that resets on every cold start (fine for local dev, useless in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
